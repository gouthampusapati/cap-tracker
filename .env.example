# Copy this to .env.local and fill in your values
# Or set in Vercel dashboard for production

# ===== LOCAL DEVELOPMENT =====
NEXTAUTH_URL=http://localhost:3000
# Real sign-in secret (Auth.js/next-auth) — used to sign session cookies.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=dev-secret-key-min-32-characters-long-for-local-dev
# "file:..." for a local SQLite file (this is what local dev uses by
# default even if unset), or a Turso "libsql://..." URL to develop
# against the real hosted DB. Vercel's serverless filesystem is
# read-only outside /tmp, so production MUST use a libsql:// URL, not a
# local file — see lib/db/index.ts.
DATABASE_URL=file:cap-tracker.db
# Only needed when DATABASE_URL is a libsql:// URL. Get one with:
#   turso db tokens create <db-name>
TURSO_AUTH_TOKEN=
NEXT_PUBLIC_URL=http://localhost:3000

# ===== REQUIRED (get from APIs) =====
# Federal Audit Clearinghouse API key
# Get at: https://api.data.gov/signup
# FAC's limit is 1,000 requests/hour PER KEY (confirmed against
# api.data.gov's own developer manual, 2026-08) — use a SEPARATE key
# here for local dev/testing than the one set in Vercel for production,
# so manual curl/dev-server traffic doesn't quietly eat into the
# production site's shared hourly budget (lib/fac-budget.ts). Both are
# free/instant to register at the signup link above.
FAC_API_KEY=your-fac-api-key-here

# ===== Google OAuth sign-in =====
# lib/auth-guard.ts / auth.ts. Without these, /auth/signin's "Sign in
# with Google" button fails — guest mode (the default /dashboard entry
# point) is unaffected either way.
# 1. Google Cloud Console → APIs & Services → Credentials → Create
#    OAuth 2.0 Client ID (Application type: Web application).
# 2. Authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google        (dev)
#      https://www.singleauditintel.com/api/auth/callback/google  (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== OPTIONAL (for Phase 2+) =====
# Claude API (for Phase 4 - CAP narrative draft generation)
ANTHROPIC_API_KEY=your-anthropic-key-here

# ===== OPTIONAL (owner notifications on early-access signups) =====
# lib/send-owner-notification.ts no-ops safely if either of these is
# unset — signups save fine either way, the email just won't send until
# both are set. Sign up at https://resend.com, get an API key, and set:
RESEND_API_KEY=
# Where the "new signup" notification goes. Not the visitor's email —
# there is deliberately no auto-reply to the visitor (see
# app/waitlist-form.tsx's doc comment).
WAITLIST_NOTIFY_EMAIL=teamgoutham@gmail.com
# Optional — defaults to Resend's shared onboarding domain, which works
# without any DNS setup but looks less trustworthy than your own domain.
# Verify singleauditintel.com in the Resend dashboard, then set e.g.:
#   RESEND_FROM_EMAIL=Single Audit Intelligence <notifications@singleauditintel.com>
RESEND_FROM_EMAIL=

# ===== PRODUCTION (Vercel) =====
# Set these in Vercel Dashboard → Settings → Environment Variables,
# and as GitHub repo secrets (Settings → Secrets and variables → Actions)
# so the CI build step has them too.
# NEXTAUTH_URL=https://www.singleauditintel.com
# NEXTAUTH_SECRET=your-secret-key-min-32-chars
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# FAC_API_KEY=your-fac-api-key-here
# NEXT_PUBLIC_URL=https://www.singleauditintel.com
# DATABASE_URL=libsql://<db-name>-<org>.turso.io   (Vercel dashboard only — the
#                                                    CI build step doesn't query the DB)
# TURSO_AUTH_TOKEN=...                              (Vercel dashboard only, same reason)
